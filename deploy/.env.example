# Copie para deploy/.env e ajuste:
#   cp deploy/.env.example deploy/.env
# O compose lê este arquivo automaticamente (project dir = deploy/).
# NUNCA comite o deploy/.env (já está no .gitignore).

# --- GIDs do host (não adivinhe os valores) ---------------------------------
#   getent group libvirt | cut -d: -f3
#   getent group kvm     | cut -d: -f3
# Debian 12: 137 / 104. Ubuntu 26.04: 982 / 992.
LIBVIRT_GID=982
KVM_GID=992

# --- IP/DNS pelo qual a UI será acessada ------------------------------------
# Entra no SAN do certificado TLS autoassinado. Sem o IP correto o browser
# acusa erro de nome em https://<ip>:8275 (o certificado é válido, o nome não).
ULTRAV_HOST_IP=192.168.8.63

# --- Segredo das sessões JWT (obrigatório) ----------------------------------
#   openssl rand -hex 32
# Sem ele o backend gera um segredo efêmero e todo login cai a cada restart.
ULTRAV_JWT_SECRET=

# --- Admin criado no primeiro boot (banco vazio) ----------------------------
# Trocar a senha depois nas configurações do usuário (PUT /api/v1/auth/password);
# alterar aqui não muda um admin já existente.
ULTRAV_ADMIN_USER=admin
ULTRAV_ADMIN_PASSWORD=admin@2026

# --- Modo do hipervisor ------------------------------------------------------
# libvirt = host KVM real (default). mock = demonstração, host fictício kvm01.
HYPERVISOR_PROVIDER=libvirt
# HYPERVISOR_LIBVIRT_URI=qemu:///system
